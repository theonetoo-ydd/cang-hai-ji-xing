[node name="TutorialBody" type="Label" parent="TutorialPanel/TutorialMargin/TutorialVBox"]
layout_mode = 2
size_flags_vertical = 3
text = "1. 在商馆选择【绫】丝绸，先买入 5 份。\n2. 点击左侧「出航 / 海图」。\n3. 在海图选择广州，点击「扬帆出航」。\n4. 抵达广州后卖出丝绸，完成第一笔跨港贸易。"
autowrap_mode = 2

[node name="TutorialStatus" type="Label" parent="TutorialPanel/TutorialMargin/TutorialVBox"]
layout_mode = 2
text = "当前目标：买入丝绸"

[node name="TutorialClose" type="Button" parent="TutorialPanel/TutorialMargin/TutorialVBox"]
layout_mode = 2
text = "知道了，开始航行"
